# PrismWorker 后端运行环境变量示例
# 复制为 .env 后按需修改；python -m app.runner 启动时自动加载（不覆盖系统已有变量）。
# 也可从 config.yaml 里用 ${VAR} 引用同名字段。

# ── API 鉴权 ──────────────────────────────────────────────
# 配置后所有接口必须携带 X-Internal-Token 头；留空 = 本地开发放行
PRISM_INTERNAL_TOKEN=

# ── 模型密钥 ──────────────────────────────────────────────
# OpenAI 兼容端点（config.yaml models[] 中 provider=openai 的模型）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# DeepSeek 官方 API（provider=deepseek 的模型）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Tavily 网页搜索工具（tools.web_search.api_key）
TAVILY_API_KEY=

# ── 运行目录与模式 ────────────────────────────────────────
# 数据根目录（线程元数据 / user-data / 双 SQLite 库 / 日志）
# 默认：不设置时用 {启动目录}/.prism-worker
PRISM_WORKER_HOME=

# 沙箱运行模式：空/auto=真实容器；显式 fake=内存沙箱（测试/无 docker 环境）
# PRISM_RUN_MODE=fake