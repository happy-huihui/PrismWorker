

# API 鉴权
# 配置后所有接口必须携带 X-Internal-Token 头；留空 = 本地开发放行
PRISM_INTERNAL_TOKEN=

# 模型密钥
# MiMo（OpenAI 兼容）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_FLASH_MODEL=mimo-v2.6-flash
MIMO_PRO_MODEL=mimo-v2.6-pro

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=

# Tavily 网页搜索工具
TAVILY_API_KEY=

# 火山方舟豆包生图
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828


# 数据根目录（线程元数据 / user-data / 双 SQLite 库 / 日志）
# 默认：不设置时用 {启动目录}/.prism-worker
PRISM_WORKER_HOME=

# 沙箱运行模式：空/auto=真实容器；显式 fake=内存沙箱（测试/无 docker 环境）
# PRISM_RUN_MODE=fake
